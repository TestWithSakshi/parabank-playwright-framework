# Copy to .env and adjust. Never commit real .env.
TEST_ENV=qa
BASE_URL=https://parabank.parasoft.com/parabank
DEFAULT_PASSWORD=Str0ng!Passw0rd123
BROWSER=chromium
# Set HEADLESS=false to watch the browser during the run.
HEADLESS=false
WORKERS=1
RETRIES=1
# Capture EVERYTHING so the Allure report has full evidence per test.
TRACE=on
VIDEO=on
SCREENSHOT=on
ALLURE_RESULTS_DIR=allure-results
